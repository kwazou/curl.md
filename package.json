{
  "name": "curl.md",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "build": "tsc",
    "gen:fixtures:md:rules": "node --experimental-strip-types scripts/updateMdRulesFixtures.ts",
    "serve": "node --experimental-strip-types --env-file-if-exists=.env src/local/serve.ts",
    "test": "vitest --config test/vitest.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.7.6",
    "hono": "^4.13.7",
    "playwright": "^1.59.1",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "tokenx": "^1.3.0",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/node": "^25.6.0",
    "@typescript/native-preview": "7.0.0-dev.20260318.1",
    "std-env": "^4.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "5.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.0.0",
      "onFail": "download"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
