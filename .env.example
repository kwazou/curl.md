# All optional. See .github/README.md.
AI_API_KEY=                    # API key for the OpenAI-compatible AI API (objective extraction)
AI_BASE_URL=                   # OpenAI-compatible API base URL (default http://localhost:11434/v1, Ollama)
AI_MODEL=                      # Model for mode=smart (default llama3.1:8b)
AI_MODEL_RUSH=                 # Model for mode=rush (default AI_MODEL)
BROWSER_RENDERING=             # Set to false to disable local Chromium rendering (default true)
GH_TOKEN=                      # GitHub token for GitHub rules (higher rate limits)
HOST=                          # Listen host (default 127.0.0.1)
PORT=                          # Listen port (default 3000)
