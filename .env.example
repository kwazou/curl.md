DB_URL=postgresql://postgres:postgres@db.curl.local:5432/curl_dev

CLOUDFLARE_ACCOUNT_ID=         # Cloudflare account ID (found in the Workers dashboard URL)
CLOUDFLARE_API_TOKEN=          # Cloudflare API token for deployments/admin scripts
CLOUDFLARE_BROWSER_API_TOKEN=  # Cloudflare Browser Rendering token with Browser Rendering -> Edit only
COOKIE_SECRET=                 # Secret for signing session cookies (openssl rand -base64 32)
GH_CLIENT_ID=                  # GitHub OAuth app client ID
GH_CLIENT_SECRET=              # GitHub OAuth app client secret
SENTRY_DSN=                    # Sentry DSN for error tracking (https://<key>@<org>.ingest.us.sentry.io/<project>)
SENTRY_AUTH_TOKEN=             # Sentry auth token for source map uploads
STRIPE_PUBLISHABLE_KEY=        # Stripe publishable key (pk_test_... or pk_live_...)
STRIPE_SECRET_KEY=             # Stripe secret key (sk_test_... or sk_live_...)
STRIPE_WEBHOOK_SECRET=         # Stripe webhook signing secret (whsec_...) `docker logs curl-stripe 2>&1 | grep -o 'whsec_[a-zA-Z0-9]*'`
TOKEN_ENCRYPTION_KEY=          # Base64-encoded 256-bit key for encrypting OAuth tokens (openssl rand -base64 32)

WRANGLER_SEND_METRICS=false

# Local server (`pnpm serve`) — all optional
AI_API_KEY=                    # Bearer token for the OpenAI-compatible AI API (objective extraction)
AI_BASE_URL=                   # OpenAI-compatible API base URL (default http://localhost:11434/v1, Ollama)
AI_MODEL=                      # Model for mode=smart (default llama3.1:8b)
AI_MODEL_RUSH=                 # Model for mode=rush (default AI_MODEL)
GH_TOKEN=                      # GitHub token for GitHub rules (higher rate limits)
